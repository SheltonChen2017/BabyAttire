{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust_icons": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "leaf",
            "heading_1": "Soft on skin",
            "icon_2": "truck",
            "heading_2": "Free shipping over $50",
            "icon_3": "return",
            "heading_3": "30-day returns"
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "size_guide": {
          "type": "text",
          "settings": {
            "text": "Not sure about size? <a href=\"/pages/size-guide\">See our size guide</a>",
            "text_style": "body"
          }
        },
        "fabric_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fabric & care",
            "icon": "washing",
            "content": "<p>Soft, breathable cotton. Machine wash cold with like colors and tumble dry low. Do not bleach.</p>",
            "page": ""
          }
        },
        "safety": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Made for little ones",
            "icon": "heart",
            "content": "<p>Nickel-free snaps, tag-free necklines and flat seams to keep delicate skin comfortable.</p>",
            "page": ""
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>Ships in 1-2 business days. Unworn items with tags can be returned within 30 days.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "size_guide",
        "quantity_selector",
        "buy_buttons",
        "trust_icons",
        "description",
        "fabric_care",
        "safety",
        "shipping",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Complete the outfit",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}

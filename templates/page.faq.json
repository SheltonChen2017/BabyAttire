    "sizing": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I pick the right size?",
            "icon": "ruler",
            "row_content": "<p>Go by your baby's weight and height first, and age second. Our <a href=\"/pages/size-guide\" title=\"Size guide\">size guide</a> has the full chart.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "My baby is between sizes. What should I do?",
            "icon": "question_mark",
            "row_content": "<p>Size up. A little extra room means more months of wear, and cuffs can be folded over until they grow into it.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do the clothes shrink?",
            "icon": "dryer",
            "row_content": "<p>Our cotton is pre-washed to keep shrinking to a minimum. Washing cold and drying on low helps keep the fit.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"

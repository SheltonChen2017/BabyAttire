        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How should I wash the clothes?",
            "icon": "washing",
            "row_content": "<p>Machine wash cold with a gentle, fragrance-free detergent and tumble dry low. Close snaps and zippers before washing.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What are the clothes made of?",
            "icon": "leaf",
            "row_content": "<p>Each product page lists its fabric under \"Fabric & care\". Most pieces are soft, breathable cotton.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are the clothes safe for sleep?",
            "icon": "heart",
            "row_content": "<p>Follow safe sleep guidance from your pediatrician. Sleepwear should fit snugly, and loose blankets should stay out of the crib.</p>"
          }
        }
      },
